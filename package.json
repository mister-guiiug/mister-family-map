{
  "name": "mister-family-map",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Carte collaborative d'idées de sorties en famille : lieux, événements et retours d'expérience réellement utiles.",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pwa-bundle-budget",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "type-check": "tsc -b --noEmit",
    "type-check:7": "pwa-typecheck-7",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:a11y": "playwright test --grep @a11y",
    "icons": "pwa-icons --source public/favicon.svg --out public --no-apple",
    "icons:maskable": "node scripts/generate-maskable.mjs",
    "verify": "npm run format:check && npm run lint && npm run type-check && npm run test && npm run build"
  },
  "bundleBudget": {
    "totalGzipKb": 822,
    "_pourquoi": "RELEVÉ DE 809 À 822 LE 05/10/2026, APRÈS TanStack Query (^5.104.1) pour les lectures ciblées (lieux, événements, catégories, avis). Le runtime Query pèse ~13 kB gzip ; 822 = ancien plafond + cette marge, sans re-mesure CI — à affiner après le prochain build Pages."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "posthog-js": "^1.438.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@mister-guiiug/dev-pwa-config": "^6.25.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@rolldown/plugin-babel": {
      "@babel/plugin-transform-runtime": "^7.29.0"
    }
  },
  "pwaDoctor": {
    "refus": {
      "wf-keepalive": "Aucun projet Supabase n'est branché en production : deploy.yml laisse VITE_SUPABASE_URL en commentaire, et l'app tourne sur son backend local (src/app/config/backend.ts ne choisit Supabase que si l'URL et la clé sont posées). Un keep-alive n'aurait rien à réveiller — et le réutilisable, qui exige ces deux secrets, échouerait tous les trois jours. À ajouter le jour où un projet est provisionné."
    }
  }
}
