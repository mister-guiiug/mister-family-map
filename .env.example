# Gabarit des variables lues par l'application. Copier en `.env` et remplir ce
# dont on a besoin : toutes sont facultatives, l'app fonctionne sans aucune.
#
# ATTENTION — `VITE_*` n'est PAS un secret. Vite recopie ces valeurs DANS le
# bundle servi : elles sont lisibles par n'importe quel visiteur. Ce qui doit
# rester secret ne passe pas par ici.

# Chemin de base du site. `/mister-family-map/` en production sur GitHub Pages,
# `/` en développement et pour les e2e.
VITE_BASE_PATH=/

# Dorsale : `local` (tout en mémoire du navigateur) ou `supabase`. Absent, la
# valeur par défaut du code s'applique.
VITE_BACKEND=

# Supabase, quand la dorsale est `supabase`. La clé anonyme est publique par
# conception — c'est RLS qui protège, pas son secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clé de projet PostHog (`phc_…`), nuage EUROPÉEN — la MÊME pour tout le parc :
# un seul projet, les applications distinguées dedans par `app_name`, que le
# socle déduit du chemin de base. Publique par conception (elle est dans le
# bundle). Absente, le bandeau de consentement ne rend rien et rien n'est
# mesuré — c'est le seul interrupteur.
# Les e2e en posent un FACTICE dans `.env.e2e`, pour que la garde de l'écran
# d'entrée ait quelque chose à vérifier.
VITE_POSTHOG_KEY=
